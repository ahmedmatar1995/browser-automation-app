{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "srvx serve --entry ./dist/server/server.js --dir . --static ./dist/client --prod",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
